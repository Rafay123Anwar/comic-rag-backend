# ============================================================
# Comic RAG Environment Configuration
# ============================================================

# Mistral AI API Key (Required)
MISTRAL_API_KEY=your_mistral_api_key_here

# Mistral Models
MISTRAL_MODEL=mistral-small-2603
LLM_MODEL=mistral-small-latest
EMBEDDING_MODEL=mistral-embed

# ============================================================
# Supabase & PostgreSQL Configuration
# ============================================================
# Connect to Supabase PostgreSQL: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///storage/comic_rag.db
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=comic-assets

# ============================================================
# Authentication Security (JWT)
# ============================================================
JWT_SECRET_KEY=change-me-to-a-super-secret-production-random-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage Root Directory
STORAGE_PATH=storage

# Conversation Memory Limit
MAX_CONVERSATION_MESSAGES=10

# Concurrency & Retries for Vision/OCR Analysis
MAX_AI_WORKERS=5
MAX_AI_RETRIES=5

# Optional: Path to 7-Zip Executable (for CBR/CBZ extraction on Windows)
SEVEN_ZIP_PATH=C:\Program Files\7-Zip\7z.exe
